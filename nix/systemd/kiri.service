# Optional Arch/EndeavourOS integration for the dedicated root-owned
# /nix/var/nix/profiles/kiri profile. Never overrides Docker's default socket.
# The 'docker' group already has root-equivalent Docker privileges; using it
# avoids creating a second privileged group for this experimental engine.
[Unit]
Description=Kiri container engine (Nix profile)
Documentation=https://github.com/sguzman/kiri
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/nix/var/nix/profiles/kiri/bin/kiri daemon
Environment=KIRI_AGENT=/nix/var/nix/profiles/kiri/bin/kiri-init
Environment=KIRI_SOCKET=/run/kiri/docker.sock
Environment=KIRI_SOCKET_GROUP=docker
Environment=KIRI_HTTP_PORT=18080
Environment=KIRI_HTTPS_PORT=18443
Environment=HOME=/var/lib/kiri-daemon
StateDirectory=kiri-daemon
StateDirectoryMode=0700
WorkingDirectory=/var/lib/kiri-daemon
RuntimeDirectory=kiri
RuntimeDirectoryMode=0755
UMask=0027
Delegate=yes
KillMode=mixed
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
